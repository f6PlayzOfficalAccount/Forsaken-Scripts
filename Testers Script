            for charName, _ in pairs(characterToggles) do
                characterToggles[charName] = false
            end
            for animName, _ in pairs(selectedTypes) do
                selectedTypes[animName] = "Default"
            end
            clearCustomTracks()
            Rayfield:Notify({
                Title = "Reset Completed",
                Content = "All animation overrides turned off.",
                Duration = 2
            })
        end
    })

    -- Dynamic UI Layout Generator (Groups by Character)
    for _, charData in ipairs(CharacterList) do
        local charName = charData.CharacterName

        -- Section Title (e.g. COOLKIDD)
        AnimTab:CreateSection(string.upper(charName))

        -- Master Toggle for this Character (Defaults to OFF)
        characterToggles[charName] = false

        AnimTab:CreateToggle({
            Name = "Toggle " .. charName .. " Animation Changer",
            CurrentValue = false,
            Flag = charName .. "MasterToggle",
            Callback = function(Value)
                characterToggles[charName] = Value
                if not Value then
                    clearCustomTracks()
                end
            end,
        })

        -- Dropdowns for every animation belonging to this Character
        for _, animData in ipairs(charData.Animations) do
            local animName = animData.Name

            local characterOptions = {}
            if animData.Replacements then
                for optionName, _ in pairs(animData.Replacements) do
                    table.insert(characterOptions, optionName)
                end
            end
            table.sort(characterOptions)

            -- Defaults to Default on script execution/reload
            selectedTypes[animName] = "Default"

            if #characterOptions > 0 then
                AnimTab:CreateDropdown({
                    Name = animName .. " Change",
                    Options = characterOptions,
                    CurrentOption = {"Default"},
                    MultipleOptions = false,
                    Flag = animName:gsub("%s+", "") .. "Dropdown",
                    Callback = function(Option)
                        local selected = type(Option) == "table" and Option[1] or Option
                        selectedTypes[animName] = selected
                        if selected == "Default" then
                            clearCustomTracks()
                        end
                    end,
                })
            end
        end
    end
