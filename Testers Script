local currentPack = "Normal"
local activeTracks = {}
local movementLoop = nil

-- Modifying internal localReset to explicitly wipe references out of memory
local function cleanAndStopTracks()
    if movementLoop then movementLoop:Disconnect() movementLoop = nil end
    for _, track in pairs(activeTracks) do pcall(function() track:Stop(0.1) track:Destroy() end) end
    table.clear(activeTracks)
    localReset()
end

local function applyPack(char)
    cleanAndStopTracks()
    if not LocalActiveRef or not LocalActiveRef.Value then return end

    local humanoid = char:WaitForChild("Humanoid")
    local root = char:WaitForChild("HumanoidRootPart")
    local animate = char:FindFirstChild("Animate")

    if currentPack == "Normal" then return end
    if animate then animate.Disabled = true end

    local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
    local pack = Animations[currentPack]
    
    for state, id in pairs(pack) do
        local anim = Instance.new("Animation")
        anim.AnimationId = id
        local track = animator:LoadAnimation(anim)
        track.Priority = Enum.AnimationPriority.Action
        track.Looped = true
        activeTracks[state] = track
    end

    local currentState = nil
    movementLoop = RunService.Heartbeat:Connect(function()
        if not LocalActiveRef or not LocalActiveRef.Value or not char.Parent or humanoid.Health <= 0 then 
            if movementLoop then movementLoop:Disconnect() end
            return 
        end
        local speed = root.AssemblyLinearVelocity.Magnitude
        local state = speed < 1 and "Idle" or (speed < 20 and "Walk" or "Run")

        if currentState ~= state then
            currentState = state
            for n, t in pairs(activeTracks) do if n ~= state then t:Stop(0.1) end end
            if activeTracks[state] then activeTracks[state]:Play(0.15) end
        end
    end)
end

