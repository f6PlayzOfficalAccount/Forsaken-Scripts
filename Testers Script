    -- 2. State & Memory Management
    local characterToggles = {}
    local selectedTypes = {}
    local customTracks = {}
    local activeTimedTracks = {}

    -- Track Cleanup
    local function clearCustomTracks()
        for _, track in pairs(customTracks) do
            pcall(function()
                track:Stop(0.1)
                track:Destroy()
            end)
        end
        table.clear(customTracks)
        table.clear(activeTimedTracks)
        if localReset then localReset() end
    end

    -- Animation Replacement Detection
    local function getReplacementAnimation(animId)
        for _, charData in ipairs(CharacterList) do
            -- Master character toggle check
            if characterToggles[charData.CharacterName] then
                for _, animData in ipairs(charData.Animations) do
                    for _, detectId in ipairs(animData.Detect or {}) do
                        if string.find(animId, detectId) then
                            local chosenType = selectedTypes[animData.Name]
                            
                            if chosenType == "Default" or chosenType == "" or not chosenType then
                                return nil, nil
                            end

                            local replacement = animData.Replacements and animData.Replacements[chosenType]
                            local duration = animData.Duration
                            
                            if type(replacement) == "table" then
                                return replacement[math.random(1, #replacement)], duration
                            elseif type(replacement) == "string" then
                                return replacement, duration
                            end
                        end
                    end
                end
            end
        end
        return nil, nil
    end

    -- 3. Character Animator Hook (Replicates across server via Humanoid.Animator)
    -- Hook Character Animator with Anti-Spam Check
    local function hookCharacter(char)
        clearCustomTracks()
        if not LocalActiveRef or not LocalActiveRef.Value then return end

        local humanoid = char:WaitForChild("Humanoid", 5)
        if not humanoid then return end

        local animator = humanoid:WaitForChild("Animator", 5)
        if not animator then return end

        animator.AnimationPlayed:Connect(function(animationTrack)
            if not LocalActiveRef or not LocalActiveRef.Value then return end

            local rawId = animationTrack.Animation.AnimationId
            local newId, duration = getReplacementAnimation(rawId)

            if newId and newId ~= "" then
                -- ANTI-SPAM: Block execution if this specific animation is already running
                if duration and activeTimedTracks[newId] then
                    animationTrack:Stop(0)
                    return
                end

                -- Stop the original played track
                animationTrack:Stop(0.1)
                
                local newAnim = Instance.new("Animation")
                newAnim.AnimationId = newId
                
                local newTrack = animator:LoadAnimation(newAnim)
                newTrack.Priority = Enum.AnimationPriority.Action4
                
                table.insert(customTracks, newTrack)
                newTrack:Play()

                -- Apply Duration & Anti-Spam Lockout
                if duration then
                    activeTimedTracks[newId] = true -- Lock track from spamming
                    newTrack.Looped = false
                    
                    task.delay(duration, function()
                        if newTrack then
                            newTrack:Stop(0.1)
                            newTrack:Destroy()
                        end
                        activeTimedTracks[newId] = nil -- Unlock track when finished
                    end)
                end
            end
        end)
    end

    if player.Character then hookCharacter(player.Character) end
    player.CharacterAdded:Connect(function(char)
        if not LocalActiveRef or not LocalActiveRef.Value then return end
        hookCharacter(char)
    end)

    -- 4. Rayfield Interface Construction
    local AnimTab = Window:CreateTab("Anim Changer", 4483362458)

    -- Master Reset Button
    AnimTab:CreateButton({
        Name = "Reset All Animations to Default",
        Callback = function()
            for charName, _ in pairs(characterToggles) do
                characterToggles[charName] = false
            end
            for animName, _ in pairs(selectedTypes) do
                selectedTypes[animName] = "Default"
            end
            clearCustomTracks()
            Rayfield:Notify({
                Title = "Reset Completed",
                Content = "All animation overrides turned off.",
                Duration = 2
            })
        end
    })

    -- Dynamic UI Layout Generator (Groups by Character)
    for _, charData in ipairs(CharacterList) do
        local charName = charData.CharacterName

        -- Section Title (e.g. COOLKIDD)
        AnimTab:CreateSection(string.upper(charName))

        -- Master Toggle for this Character (Defaults to OFF)
        characterToggles[charName] = false

        AnimTab:CreateToggle({
            Name = "Toggle " .. charName .. " Animation Changer",
            CurrentValue = false,
            Flag = charName .. "MasterToggle",
            Callback = function(Value)
                characterToggles[charName] = Value
                if not Value then
                    clearCustomTracks()
                end
            end,
        })

        -- Dropdowns for every animation belonging to this Character
        for _, animData in ipairs(charData.Animations) do
            local animName = animData.Name

            local characterOptions = {}
            if animData.Replacements then
                for optionName, _ in pairs(animData.Replacements) do
                    table.insert(characterOptions, optionName)
                end
            end
            table.sort(characterOptions)

            -- Defaults to Default on script execution/reload
            selectedTypes[animName] = "Default"

            if #characterOptions > 0 then
                AnimTab:CreateDropdown({
                    Name = animName .. " Change",
                    Options = characterOptions,
                    CurrentOption = {"Default"},
                    MultipleOptions = false,
                    Flag = animName:gsub("%s+", "") .. "Dropdown",
                    Callback = function(Option)
                        local selected = type(Option) == "table" and Option[1] or Option
                        selectedTypes[animName] = selected
                        if selected == "Default" then
                            clearCustomTracks()
                        end
                    end,
                })
            end
        end
    end
