                local originalRig = rigFolder and rigFolder:FindFirstChild("RabbidRig")
                
                if originalRig then
                    print("Found original RabbidRig template!")
                    local activeRabbidRig = char:FindFirstChild("ActiveRabbidRig")
                    
                    if not activeRabbidRig then
                        activeRabbidRig = originalRig:Clone()
                        activeRabbidRig.Name = "ActiveRabbidRig"
                        activeRabbidRig.Parent = char
                        
                        -- Hide all parts initially and weld them to the character
                        local rootPart = char:FindFirstChild("HumanoidRootPart")
                        for _, v in ipairs(activeRabbidRig:GetChildren()) do
                            if v:IsA("BasePart") then
                                v.Transparency = 1
                                if rootPart and v.Name ~= "RabbitRoot" then
                                    local weld = Instance.new("WeldConstraint")
                                    weld.Part0 = rootPart
                                    weld.Part1 = v
                                    weld.Parent = v
                                end
                            end
                        end
                        print("Successfully cloned and welded ActiveRabbidRig to character!")
                    end
                    
                    local tweenService = game:GetService("TweenService")
                    
                    -- Fade parts IN
                    for _, v in ipairs(activeRabbidRig:GetChildren()) do
                        if v:IsA("BasePart") and v.Name ~= "RabbitRoot" then
                            tweenService:Create(v, TweenInfo.new(0.2), {Transparency = 0}):Play()
                        end
                    end
                    
                    -- Safety fallback: Fade parts OUT after exactly 2 seconds
                    task.delay(2.0, function()
                        if activeRabbidRig and activeRabbidRig.Parent then
                            for _, v in ipairs(activeRabbidRig:GetChildren()) do
                                if v:IsA("BasePart") and v.Name ~= "RabbitRoot" then
                                    tweenService:Create(v, TweenInfo.new(0.3), {Transparency = 1}):Play()
                                end
                            end
                        end
                    end)
                else
                    warn("Could not find RabbidRig inside the Rig folder!")
                end
            else
                warn("Could not locate RabbidsPaintballGuest folder via ReplicatedStorage path!")
            end
        end
    end

    -- Animation Replacement Detection
    local function getReplacementAnimation(animId)
        for _, charData in ipairs(CharacterList) do
            -- Master character toggle check
            if characterToggles[charData.CharacterName] then
                for _, animData in ipairs(charData.Animations) do
                    for _, detectId in ipairs(animData.Detect or {}) do
                        if string.find(animId, detectId) then
                            local chosenType = selectedTypes[animData.Name]
                            
                            if chosenType == "Default" or chosenType == "" or not chosenType then
                                return nil, nil, false, false, animData.Name
                            end

                            local replacement = animData.Replacements and animData.Replacements[chosenType]
                            local duration = animData.Duration
                            local isChecking = animData.IsChecking == true 
                            local ignoreWait = animData.IgnoreWait == true 
                            
                            if type(replacement) == "table" then
                                return replacement[math.random(1, #replacement)], duration, isChecking, ignoreWait, animData.Name
                            elseif type(replacement) == "string" then
                                return replacement, duration, isChecking, ignoreWait, animData.Name
                            end
                        end
                    end
                end
            end
        end
        return nil, nil, false, false, nil
    end

    -- 3. Character Animator Hook (Replicates across server via Humanoid.Animator)
    local function hookCharacter(char)
        clearCustomTracks()
        if not LocalActiveRef or not LocalActiveRef.Value then return end

        local humanoid = char:WaitForChild("Humanoid", 5)
        if not humanoid then return end

        local animator = humanoid:WaitForChild("Animator", 5)
        if not animator then return end

        animator.AnimationPlayed:Connect(function(animationTrack)
            if not LocalActiveRef or not LocalActiveRef.Value then return end

            local rawId = animationTrack.Animation.AnimationId
            local newId, duration, isChecking, ignoreWait, animName = getReplacementAnimation(rawId)

            -- Trigger the Guest prop animation logic if name matches
            triggerGuestProp(char, animName)

            if newId and newId ~= "" then
                -- ANTI-SPAM: Block execution if already running 
                if not isChecking and not ignoreWait and duration and activeTimedTracks[newId] then
                    animationTrack:Stop(0)
                    return
                end

                -- Handle IsChecking Loop Logic
                if isChecking then
                    -- Prevent stacking duplicate loops if already active
                    if activeCheckingTracks[rawId] and activeCheckingTracks[rawId].IsPlaying then
                        return
                    end

                    local newAnim = Instance.new("Animation")
                    newAnim.AnimationId = newId
                    
                    local newTrack = animator:LoadAnimation(newAnim)
                    newTrack.Priority = Enum.AnimationPriority.Action4
                    newTrack.Looped = true
                    
                    table.insert(customTracks, newTrack)
                    activeCheckingTracks[rawId] = newTrack

                    pcall(function()
                        newTrack:Play()
                    end)

                    local stopConnection
                    stopConnection = animationTrack.Stopped:Connect(function()
                        if stopConnection then
                            stopConnection:Disconnect()
                            stopConnection = nil
                        end
                        if activeCheckingTracks[rawId] == newTrack then
                            activeCheckingTracks[rawId] = nil
                        end
                        if newTrack then
                            pcall(function()
                                newTrack:Stop(0.1)
                                newTrack:Destroy()
                            end)
                        end
                    end)

                    newTrack.Stopped:Connect(function()
                        if stopConnection then
                            stopConnection:Disconnect()
                            stopConnection = nil
                        end
                        if activeCheckingTracks[rawId] == newTrack then
                            activeCheckingTracks[rawId] = nil
                        end
                    end)
                else
                    -- Standard non-looping animation logic (stops original track immediately)
                    animationTrack:Stop(0.1)
                    
                    local newAnim = Instance.new("Animation")
                    newAnim.AnimationId = newId
                    
                    local newTrack = animator:LoadAnimation(newAnim)
                    newTrack.Priority = Enum.AnimationPriority.Action4
                    
                    table.insert(customTracks, newTrack)
                    newTrack:Play()

                    -- Apply Duration & Anti-Spam Lockout
                    if duration then
                        activeTimedTracks[newId] = true 
                        newTrack.Looped = false
                        
                        task.delay(duration, function()
                            if newTrack then
                                newTrack:Stop(0.1)
                                newTrack:Destroy()
                            end
                            activeTimedTracks[newId] = nil 
                        end)
                    end
                end
            end
        end)
    end

    if player.Character then hookCharacter(player.Character) end
    player.CharacterAdded:Connect(function(char)
        if not LocalActiveRef or not LocalActiveRef.Value then return end
        hookCharacter(char)
    end)
