    -- Forward declaration of global reset logic so buttons can invoke it cleanly
    local function localReset()
        local char = player.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            local animScript = char:FindFirstChild("Animate")
            if animScript then 
                animScript.Disabled = true
                animScript.Disabled = false 
            end
            if hum then
                for _, track in pairs(hum:GetPlayingAnimationTracks()) do
                    track:Stop(0.1)
                end
            end
        end
    end

    -- Global cleanup sequence for exiting the script completely
    local function totalCleanup()
        if LocalActiveRef then LocalActiveRef.Value = false end
        
        -- Stop custom loops
        localReset()
        
        -- Restore Environment Defaults
        Lighting.ClockTime = DefaultClockTime
        Lighting.Brightness = DefaultBrightness
        if TextChatService.ChatWindowConfiguration then
            TextChatService.ChatWindowConfiguration.Enabled = true
        end
        
        -- Fire external custom reset setups if they exist
        pcall(function()
            if _G.ForsakenReset then 
                _G.ForsakenReset() 
            end
        end)
    end

