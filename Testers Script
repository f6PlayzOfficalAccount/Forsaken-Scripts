-- Dynamic Dropdown Generator
for _, animData in ipairs(List) do
    local animName = animData.Name

    local characterOptions = {}
    if animData.Replacements then
        for charName, _ in pairs(animData.Replacements) do
            table.insert(characterOptions, charName)
        end
    end
    table.sort(characterOptions)

    -- Default selection is Normal on script launch / reload
    selectedTypes[animName] = "Normal"
    activeToggles[animName] = false

    AnimTab:CreateToggle({
        Name = "Enable " .. animName .. " Change",
        CurrentValue = false,
        Flag = animName:gsub("%s+", "") .. "Toggle",
        Callback = function(Value)
            activeToggles[animName] = Value
            if not Value then
                clearCustomTracks()
            end
        end,
    })

    if #characterOptions > 0 then
        AnimTab:CreateDropdown({
            Name = animName .. " Changer",
            Options = characterOptions,
            CurrentOption = {"Normal"},
            MultipleOptions = false,
            Flag = animName:gsub("%s+", "") .. "Dropdown",
            Callback = function(Option)
                local selected = type(Option) == "table" and Option[1] or Option
                selectedTypes[animName] = selected
                if selected == "Normal" then
                    clearCustomTracks()
                end
            end,
        })
    end
end
