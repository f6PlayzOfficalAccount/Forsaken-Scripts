local function applyMorph(modelRig, morphName)
    local char = player.Character or player.CharacterAdded:Wait()
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then 
        warn("No HumanoidRootPart found!")
        return 
    end

    local cframe = hrp.CFrame

    -- Wipe visual parts from local character
    for _, child in pairs(char:GetChildren()) do
        if child.Name ~= "Humanoid" 
        and child.Name ~= "HumanoidRootPart" 
        and child.Name ~= "SpeedMultipliers" 
        and child.Name ~= "FOVMultipliers" 
        and child.Name ~= "SpeedCapMultipliers" 
        and child.Name ~= "ResistanceMultipliers"
        and child.Name ~= "CollisionHitbox"
        and child.Name ~= "QueryHitbox" then
            child:Destroy()
        end
    end

    local morphClone = modelRig:Clone()
    if morphClone and morphClone:IsA("Model") then
        -- Step 1: Ensure all BaseParts are unanchored, non-collidable, AND massless
        for _, descendant in pairs(morphClone:GetDescendants()) do
            if descendant:IsA("BasePart") then
                descendant.Anchored = false
                descendant.Massless = true -- Prevents custom parts from adding weight to the character
                if descendant.Name ~= "HumanoidRootPart" then
                    descendant.CanCollide = false
                end
            end
        end

        -- Step 2: Parent and attach parts to the player character
        for _, part in pairs(morphClone:GetChildren()) do
            if part.Name == "Humanoid" or part.Name == "HumanoidRootPart" then
                if part.Name == "HumanoidRootPart" then
                    local rootJoint = part:FindFirstChild("RootJoint")
                    if rootJoint then rootJoint:Destroy() end

                    for _, motor in pairs(part:GetChildren()) do
                        if motor:IsA("Motor6D") then
                            motor.Parent = char.HumanoidRootPart
                            motor.Part0 = char.HumanoidRootPart
                        end
                    end
                end
                part:Destroy()
            else
                part.Parent = char
                if part.Name == "Torso" or part.Name == "UpperTorso" then
                    part.CFrame = cframe
                end
            end
        end
        morphClone:Destroy()
    else
        warn("Model not found or invalid format!")
        return
    end

    task.wait()

    local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
    local rootJoint = hrp:FindFirstChild("RootJoint")

    if torso and rootJoint then
        rootJoint.Part1 = torso
    else
        warn("Could not reattach RootJoint: Missing parts.")
    end
    
    Rayfield:Notify({
        Title = "Morph Applied",
        Content = "Visually morphed into " .. morphName,
        Duration = 2
    })
end

