-- Tracking tables (Same structure as original script)
local activeToggles = {}
local selectedTypes = {}
local customTracks = {}
local activeTimedTracks = {}

-- Clean & Stop tracks (Identical to Animations tab cleanup)
local function clearCustomTracks()
    for _, track in pairs(customTracks) do
        pcall(function()
            track:Stop(0.1)
            track:Destroy()
        end)
    end
    table.clear(customTracks)
    table.clear(activeTimedTracks)
    localReset()
end

-- Get replacement animation ID and Duration
local function getReplacementAnimation(animId)
    for _, animData in ipairs(List) do
        if activeToggles[animData.Name] then
            for _, detectId in ipairs(animData.Detect or {}) do
                if string.find(animId, detectId) then
                    local chosenType = selectedTypes[animData.Name]
                    
                    -- If set to Normal or empty, return nil to play original animation
                    if chosenType == "Normal" or chosenType == "" or not chosenType then
                        return nil, nil
                    end

                    local replacement = animData.Replacements and animData.Replacements[chosenType]
                    local duration = animData.Duration
                    
                    if type(replacement) == "table" then
                        return replacement[math.random(1, #replacement)], duration
                    elseif type(replacement) == "string" then
                        return replacement, duration
                    end
                end
            end
        end
    end
    return nil, nil
end

-- Hook Character Animator
local function hookCharacter(char)
    clearCustomTracks()
    if not LocalActiveRef or not LocalActiveRef.Value then return end

    local humanoid = char:WaitForChild("Humanoid", 5)
    if not humanoid then return end

    local animator = humanoid:WaitForChild("Animator", 5)
    if not animator then return end

    animator.AnimationPlayed:Connect(function(animationTrack)
        if not LocalActiveRef or not LocalActiveRef.Value then return end

        local rawId = animationTrack.Animation.AnimationId
        local newId, duration = getReplacementAnimation(rawId)

        if newId and newId ~= "" then
            if duration and activeTimedTracks[newId] then
                animationTrack:Stop(0)
                return
            end

            animationTrack:Stop(0.1)
            
            local newAnim = Instance.new("Animation")
            newAnim.AnimationId = newId
            
            local newTrack = animator:LoadAnimation(newAnim)
            newTrack.Priority = Enum.AnimationPriority.Action4
            
            table.insert(customTracks, newTrack)
            newTrack:Play()

            if duration then
                activeTimedTracks[newId] = true
                newTrack.Looped = false
                
                task.delay(duration, function()
                    if newTrack then
                        newTrack:Stop(0.1)
                        newTrack:Destroy()
                    end
                    activeTimedTracks[newId] = nil
                end)
            end
        end
    end)
end

if player.Character then hookCharacter(player.Character) end
player.CharacterAdded:Connect(function(char)
    if not LocalActiveRef or not LocalActiveRef.Value then return end
    hookCharacter(char)
end)

