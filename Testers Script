local function playSummonAnim(char, ID)
    local humanoid = char:WaitForChild("Humanoid")
    local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)

    if currentSummonTrack and currentSummonTrack.IsPlaying then
        currentSummonTrack:Stop(0)
    end

    local startAnim = Instance.new("Animation")
    startAnim.AnimationId = "rbxassetid://" .. tostring(ID)
    
    currentSummonTrack = animator:LoadAnimation(startAnim)
    currentSummonTrack.Priority = Enum.AnimationPriority.Action4
    currentSummonTrack.Looped = false
    currentSummonTrack:Play(0.1)
end

local function cleanAndStopTracks()
    if movementLoop then 
        movementLoop:Disconnect() 
        movementLoop = nil 
    end
    for _, track in pairs(activeTracks) do
        if track then 
            pcall(function() track:Stop(0.1) track:Destroy() end)
        end
    end
    table.clear(activeTracks)
end

local function applyPack(char)
    cleanAndStopTracks()
    if not LocalActiveRef or not LocalActiveRef.Value then return end

    local humanoid = char:WaitForChild("Humanoid")
    local root = char:WaitForChild("HumanoidRootPart")
    local animate = char:FindFirstChild("Animate")

    if currentPack == "Normal" then return end
    if animate then animate.Disabled = true end

    local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
    local pack = Animations[currentPack]
    if not pack then return end
    
    for state, id in pairs(pack) do
        if id ~= "" and id ~= "rbxassetid://" then
            local anim = Instance.new("Animation")
            anim.AnimationId = id
            local track = animator:LoadAnimation(anim)
            track.Priority = Enum.AnimationPriority.Action
            track.Looped = true
            activeTracks[state] = track
        end
    end

    -- Play start animation using the current active character
    if currentPack == "Coolkidd Minion" then
        playSummonAnim(char, 18886065814)
    elseif currentPack == "PhonkKidd Minion1" then
        playSummonAnim(char, 82390728991526)
    elseif currentPack == "PhonkKidd Minion2" then
        playSummonAnim(char, 113085302078049)
    elseif currentPack == "1X FURRY MINNION" then
        playSummonAnim(char, 99649911319033)
    elseif currentPack == "1X Minion" then
        playSummonAnim(char, 75804462760596)
    elseif currentPack == "Two Time Crouch" then
        playSummonAnim(char, 98606150731314)
    elseif currentPack == "Mequot Enraged" then
        playSummonAnim(char, 125740920231913)
    elseif currentPack == "Krystal Coolkidd Minion Guitar" then
        playSummonAnim(char, 97039674665952)

    elseif currentPack == "Krystal Coolkidd Minion Harp" then
        playSummonAnim(char, 106838261914685)

    elseif currentPack == "Krystal Coolkidd Minion Saxophone" then
        playSummonAnim(char, 120998373635026)

    elseif currentPack == "Krystal Coolkidd Minion Tuba" then
        playSummonAnim(char, 109515187409977)
    --elseif currentPack == "Slasher Enraged" then
        --playSummonAnim(char, nil)
    --Pest Enraged
    elseif currentPack == "Pest Enraged" then
        playSummonAnim(char, 88786572272093)
    elseif currentPack == "TV TIME MINION" then
        playSummonAnim(char, 134813951700806)
    end
    --TV TIME MINION
    --125740920231913

    local currentState = nil
    
    movementLoop = RunService.Heartbeat:Connect(function()
        if not LocalActiveRef or not LocalActiveRef.Value or not char.Parent or humanoid.Health <= 0 then 
            if movementLoop then movementLoop:Disconnect() end
            return 
        end
        
        local speed = root.AssemblyLinearVelocity.Magnitude
        
        -- Determine state with a minor buffer to prevent rapid flickering
        local state = "Idle"
        if speed >= 1.5 then
            state = (speed < 19.5) and "Walk" or "Run"
        end

        if currentState ~= state then
            currentState = state
            
            -- Stop other tracks with a smooth fade-out (e.g., 0.25s)
            for n, t in pairs(activeTracks) do 
                if n ~= state and n ~= "Start" then 
                    t:Stop(0.25) 
                end 
            end
            
            local activeTrack = activeTracks[state]
            if activeTrack then 
                -- Lookup custom speed multiplier or fallback to normal speed (1.0)
                local customSpeed = (packSpeeds[currentPack] and packSpeeds[currentPack][state]) or 1.0
                
                -- Play the new track with a smooth crossfade-in (e.g., 0.25s)
                activeTrack:Play(0.25)
                activeTrack:AdjustSpeed(customSpeed)
            end
        end
    end)
end

