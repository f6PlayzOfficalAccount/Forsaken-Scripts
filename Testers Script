-- Helper function to safely read expression assets from a model or skin config without breaking
local function getExpressionsFromConfig(modelOrSkinFolder, lifeIndex)
    if not modelOrSkinFolder then return nil end
    local configModule = modelOrSkinFolder:FindFirstChild("Config")
    if not configModule or not configModule:IsA("ModuleScript") then return nil end

    local success, configData = pcall(require, configModule)
    if success and type(configData) == "table" then
        lifeIndex = lifeIndex or 1
        if configData.ExpressionsTable and type(configData.ExpressionsTable) == "table" then
            return configData.ExpressionsTable[lifeIndex] or configData.ExpressionsTable[1]
        end
        return configData.Expressions
    end
    return nil
end

-- Core Visual Morph Function with explicit Life-stage Rig welding
local function applyMorph(survivorModel, morphName, skinContainer, baseContainer, lifeIndex)
    local char = player.Character or player.CharacterAdded:Wait()
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then 
        warn("No HumanoidRootPart found!")
        return 
    end

    local cframe = hrp.CFrame

    -- Wipe visual parts from local character
    for _, child in pairs(char:GetChildren()) do
        if child.Name ~= "Humanoid" 
        and child.Name ~= "HumanoidRootPart" 
        and child.Name ~= "SpeedMultipliers" 
        and child.Name ~= "FOVMultipliers" 
        and child.Name ~= "SpeedCapMultipliers" 
        and child.Name ~= "ResistanceMultipliers"
        and child.Name ~= "CollisionHitbox"
        and child.Name ~= "QueryHitbox" then
            child:Destroy()
        end
    end

    -- For TwoTime skins, we always want TwoTime's core base Rig, but life stage parts come from skin container
    local baseRigTemplate = nil
    if baseContainer and baseContainer.Name == "TwoTime" then
        baseRigTemplate = baseContainer:FindFirstChild("Rig")
    end
    
    if not baseRigTemplate then
        local activeContainer = skinContainer or baseContainer
        baseRigTemplate = activeContainer:FindFirstChild("Rig") or survivorModel:FindFirstChild("Rig") or survivorModel
    end

    local morphClone = baseRigTemplate:Clone()
    if not morphClone or not morphClone:IsA("Model") then
        warn("Model not found or invalid format!")
        return
    end

    -- Step 2: Ensure all BaseParts are unanchored and massless
    for _, descendant in pairs(morphClone:GetDescendants()) do
        if descendant:IsA("BasePart") then
            descendant.Anchored = false
            descendant.Massless = true 
            if descendant.Name ~= "HumanoidRootPart" then
                descendant.CanCollide = false
            end
        end
    end

    -- Step 3: Parent and attach parts to player character
    for _, part in pairs(morphClone:GetChildren()) do
        if part.Name == "Humanoid" or part.Name == "HumanoidRootPart" then
            if part.Name == "HumanoidRootPart" then
                local rootJoint = part:FindFirstChild("RootJoint")
                if rootJoint then rootJoint:Destroy() end

                for _, motor in pairs(part:GetChildren()) do
                    if motor:IsA("Motor6D") then
                        motor.Parent = char.HumanoidRootPart
                        motor.Part0 = char.HumanoidRootPart
                    end
                end
            end
            part:Destroy()
        else
            part.Parent = char
            if part.Name == "Torso" or part.Name == "UpperTorso" then
                part.CFrame = cframe
            end
        end
    end
    morphClone:Destroy()

    task.wait()

    local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
    local rootJoint = hrp:FindFirstChild("RootJoint")

    if torso and rootJoint then
        rootJoint.Part1 = torso
    else
        warn("Could not reattach RootJoint: Missing parts.")
    end

    -- Step 4: Overlay Life-stage specific visual model
    lifeIndex = lifeIndex or 1
    local lifeFolderOrModel = nil

    local searchContainer = skinContainer or baseContainer
    if searchContainer then
        lifeFolderOrModel = searchContainer:FindFirstChild("Life" .. lifeIndex)
        if not lifeFolderOrModel and searchContainer:FindFirstChild("Config") then
            lifeFolderOrModel = searchContainer.Config:FindFirstChild("Life" .. lifeIndex)
        end
    end

    if not lifeFolderOrModel and baseContainer and baseContainer ~= searchContainer then
        lifeFolderOrModel = baseContainer:FindFirstChild("Life" .. lifeIndex)
    end

    if lifeFolderOrModel then
        local lifeAppearance = lifeFolderOrModel
        if lifeAppearance:IsA("Folder") then
            local children = lifeAppearance:GetChildren()
            if #children > 0 then
                lifeAppearance = children[math.random(#children)]
            end
        end

        local clonedLifeVisual = lifeAppearance:Clone()
        for _, desc in pairs(clonedLifeVisual:GetDescendants()) do
            if desc:IsA("BasePart") then
                desc.Anchored = false
                desc.CanCollide = false
                desc.CanTouch = false
                desc.CanQuery = false
                desc.Massless = true
            end
        end

        for _, lifePart in pairs(clonedLifeVisual:GetChildren()) do
            if lifePart:IsA("BasePart") then
                local charMatchPart = char:FindFirstChild(lifePart.Name)
                if charMatchPart and charMatchPart:IsA("BasePart") then
                    lifePart.CFrame = charMatchPart.CFrame
                    local weld = Instance.new("WeldConstraint")
                    weld.Part0 = charMatchPart
                    weld.Part1 = lifePart
                    weld.Parent = lifePart
                end
            end
        end
        clonedLifeVisual.Parent = char
    end

    -- Step 5: Setup ExpressionHolder and expression mapping (with Veeronica flat face check)
    -- Step 5: Setup ExpressionHolder and expression mapping (with Veeronica flat face check & offsets)
    local expressions = getExpressionsFromConfig(skinContainer or baseContainer, lifeIndex)
    if not expressions and baseContainer then
        expressions = getExpressionsFromConfig(baseContainer, lifeIndex)
    end

    if expressions then
        local head = char:FindFirstChild("Head")
        if head then
            if char:FindFirstChild("ExpressionHolder") then
                char.ExpressionHolder:Destroy()
            end
            
            -- Check if the current morph/character is Veeronica
            local isVeeronica = (morphName and string.lower(morphName):find("veeronica")) 
                or (baseContainer and string.lower(baseContainer.Name):find("veeronica"))
                or (survivorModel and string.lower(survivorModel.Name):find("veeronica"))

            local IsHelp = (morphName and string.lower(morphName):find("helperbot")) 
                or (baseContainer and string.lower(baseContainer.Name):find("helperbot"))
                or (survivorModel and string.lower(survivorModel.Name):find("helperbot"))


            local InsertService = game:GetService("InsertService")
            local success, expressionHolder = pcall(function()
                if isVeeronica or IsHelp then
                    local flatPart = Instance.new("Part")
                    flatPart.Size = Vector3.new(1.2, 1.2, 0.05)
                    return flatPart
                else
                    return InsertService:CreateMeshPartAsync(
                        "rbxassetid://539723444", 
                        Enum.CollisionFidelity.Default, 
                        Enum.RenderFidelity.Automatic
                    )
                end
            end)

            if success and expressionHolder then
                expressionHolder.Name = "ExpressionHolder"
                if not isVeeronica or not IsHelp then
                    expressionHolder.Size = Vector3.new(1.2, 1.2, 1.2)
                end
                expressionHolder.Transparency = 1
                expressionHolder.CanCollide = false
                expressionHolder.CanQuery = false
                expressionHolder.CanTouch = false
                expressionHolder.Massless = true

                -- CONFIGURABLE OFFSET: Change these numbers (X, Y, Z) to shift the face position
                -- If it's clipping inside or too far, adjust the Z value here:
                local expressionOffset = isVeeronica and CFrame.new(0, 0.2, -0.65) or CFrame.new(0, 0, 0)
                local expressionOffset = IsHelp and CFrame.new(0, 0.1, -0.2) or CFrame.new(0, 0, 0)

                -- Apply head CFrame multiplied by the offset cleanly
                expressionHolder.CFrame = head.CFrame * expressionOffset
                expressionHolder.Parent = char

                local weld = Instance.new("WeldConstraint")
                weld.Name = "WeldConstraint"
                weld.Part0 = head
                weld.Part1 = expressionHolder
                weld.Parent = expressionHolder
            end

            local faceDecal = Instance.new("Decal")
            faceDecal.Name = "Expression"
            faceDecal.Face = Enum.NormalId.Front
            local defaultAsset = expressions.Default or "rbxassetid://0"
            faceDecal.Texture = defaultAsset
            faceDecal.Parent = expressionHolder

            local humanoid = char:FindFirstChildOfClass("Humanoid")
            
            if _G.ExpressionConnection then
                _G.ExpressionConnection:Disconnect()
            end
            if _G.EmoteAttrConnection then
                _G.EmoteAttrConnection:Disconnect()
            end

            local function updateExpression()
                local isEmoting = char:GetAttribute("IsEmoting")
                if isEmoting then
                    faceDecal.Texture = expressions.Happy or "rbxassetid://1067035"
                    return
                end

                if humanoid then
                    local health = humanoid.Health
                    if health <= 0 then
                        faceDecal.Texture = expressions.Dead or defaultAsset
                    elseif health <= (humanoid.MaxHealth * 0.50) then
                        faceDecal.Texture = expressions.Injured or expressions.Hurt or defaultAsset
                    else
                        faceDecal.Texture = defaultAsset
                    end
                end
            end

            _G.EmoteAttrConnection = char:GetAttributeChangedSignal("IsEmoting"):Connect(function()
                if not char:IsDescendantOf(workspace) then return end
                updateExpression()
            end)

            if humanoid then
                local lastHealth = humanoid.Health
                local isHurting = false

                _G.ExpressionConnection = humanoid.HealthChanged:Connect(function(health)
                    if not char:IsDescendantOf(workspace) then return end
                    if char:GetAttribute("IsEmoting") then return end

                    if health < lastHealth then
                        isHurting = true
                        local hurtAsset = expressions.Hurt or expressions.Injured
                        if hurtAsset then faceDecal.Texture = hurtAsset end

                        task.delay(0.7, function()
                            if not char:IsDescendantOf(workspace) then return end
                            isHurting = false
                            updateExpression()
                        end)
                    end

                    lastHealth = health

                    if not isHurting then
                        updateExpression()
                    end
                end)
            end
        end
    end
    
    Rayfield:Notify({
        Title = "Morph Applied",
        Content = "Visually morphed into " .. morphName,
        Duration = 2
    })
end

local Players = game:GetService("Players")

local function applyPlayerMorph(userId, morphName)
    local success, result = pcall(function()
        -- Fetch the player's description and force generate an R6 rig model
        local humanoidDescription = Players:GetHumanoidDescriptionFromUserId(userId)
        local model = Players:CreateHumanoidModelFromDescription(humanoidDescription, Enum.HumanoidRigType.R6)
        return model
    end)

    if success and result then
        result.Name = "PlayerMorph_" .. userId
        
        -- Call your main applyMorph function safely with the forced R6 model
        applyMorph(result, morphName, nil, result, 1)
        
        -- Clean up the temporary template model from workspace after it clones
        task.delay(1, function()
            if result and result.Parent == workspace then
                result:Destroy()
            end
        end)
    else
        Rayfield:Notify({
            Title = "Morph Error",
            Content = "Could not load R6 player data for User ID: " .. tostring(userId),
            Duration = 3
        })
    end
end

