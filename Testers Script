task.spawn(function()
    while LocalActiveRef and LocalActiveRef.Parent and LocalActiveRef.Value do
        task.wait(0.3)
        local LMS_Path = workspace:FindFirstChild("Themes") and workspace.Themes:FindFirstChild("LastSurvivor")
        if LMS_Path and LMS_Path:IsA("Sound") then
            if not LMS_Path:GetAttribute("OriginalGameTrack") then
                LMS_Path:SetAttribute("OriginalGameTrack", tostring(LMS_Path.SoundId))
            end
            
            local actualGameId = LMS_Path:GetAttribute("OriginalGameTrack")

            for originalId, activeRuntime in pairs(LMSRuntimeRegistry) do
                local detectIdClean = string.match(originalId, "%d+")
                if not string.find(actualGameId, detectIdClean) then continue end

                local currentOptionName = ""
                if activeRuntime.Mode == "Dropbox" then
                    currentOptionName = activeRuntime.SelectedData.Name
                elseif activeRuntime.Mode == "Toggle" then
                    if activeRuntime.Active == true then
                        currentOptionName = activeRuntime.Data.ToggleName
                    else
                        currentOptionName = "Default Audio"
                    end
                end

                if LMS_Path:GetAttribute("TheLms") == currentOptionName then continue end

                local finalLMSAsset = nil
                if activeRuntime.Mode == "Dropbox" then
                    local selectedData = activeRuntime.SelectedData
                    if selectedData.Type == "Roblox" then
                        finalLMSAsset = selectedData.TargetId
                    elseif selectedData.Type == "Local" and getasset then
                        finalLMSAsset = getasset(lmsFolder .. "/" .. selectedData.FileName)
                    end
                elseif activeRuntime.Mode == "Toggle" then
                    if activeRuntime.Active == true then
                        local toggleData = activeRuntime.Data
                        if toggleData.Type == "Roblox" then
                            finalLMSAsset = toggleData.TargetId
                        elseif toggleData.Type == "Local" and getasset then
                            finalLMSAsset = getasset(lmsFolder .. "/" .. toggleData.FileName)
                        end
                    else
                        finalLMSAsset = originalId
                    end
                end

                if finalLMSAsset then
                    LMS_Path.SoundId = finalLMSAsset
                    LMS_Path:SetAttribute("TheLms", currentOptionName)
                    print("[LMS Matrix] Verified source track. Switched to: " .. currentOptionName)
                end
            end
        end
    end
    
    totalCleanup()
    print("[LMS Swapper] Clash-proof monitoring thread stopped.")
end)
