local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local SECRET_PREFIX = "[EX_EMOTE]:"

local RemotePlayerProps = {}
local currentProp = nil

-- ==========================================
-- 1. MIC SPAWNER
-- ==========================================
local function SpawnSillyBillyMic(character)
    if not character then return nil end
    local leftArm = character:FindFirstChild("Left Arm") or character:FindFirstChild("LeftHand")
    if not leftArm then return nil end

    if character:FindFirstChild("MeshPart") then
        character.MeshPart:Destroy()
    end

    local micPart = Instance.new("Part")
    micPart.Name = "MeshPart"
    micPart.Size = Vector3.new(0.001, 0.001, 0.001)
    micPart.CanCollide = false
    micPart.Anchored = false

    local mesh = Instance.new("SpecialMesh")
    mesh.Name = "Mesh"
    mesh.MeshType = Enum.MeshType.FileMesh
    mesh.MeshId = "rbxassetid://6537209405"
    mesh.TextureId = "rbxassetid://6505895675"
    mesh.Scale = Vector3.new(0.065, 0.065, 0.065)
    mesh.Parent = micPart

    micPart.CFrame = leftArm.CFrame * CFrame.new(0, -1, -0.3)

    local weld = Instance.new("WeldConstraint")
    weld.Name = "WeldConstraint"
    weld.Part0 = leftArm
    weld.Part1 = micPart
    weld.Parent = micPart

    micPart.Parent = character
    return micPart
end

-- ==========================================
-- 2. EXECUTOR BROADCASTING
-- ==========================================
local function SendSignal(action)
    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        local channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
        if channel then
            channel:SendAsync(SECRET_PREFIX .. action)
        end
    else
        local legacyRemote = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
        if legacyRemote and legacyRemote:FindFirstChild("SayMessageRequest") then
            legacyRemote.SayMessageRequest:FireServer(SECRET_PREFIX .. action, "All")
        end
    end
end

-- Listen for other executor users
Players.PlayerChatted:Connect(function(chatType, sender, message)
    if sender == LocalPlayer then return end

    if message == SECRET_PREFIX .. "SillyBilly_Start" then
        if sender.Character then
            RemotePlayerProps[sender.UserId] = SpawnSillyBillyMic(sender.Character)
        end
    elseif message == SECRET_PREFIX .. "SillyBilly_Stop" then
        if RemotePlayerProps[sender.UserId] then
            RemotePlayerProps[sender.UserId]:Destroy()
            RemotePlayerProps[sender.UserId] = nil
        end
    end
end)

-- ==========================================
-- 3. MAIN HOOKS
-- ==========================================
local function stopAllEmotes()
    if currentProp then
        currentProp:Destroy()
        currentProp = nil
        SendSignal("SillyBilly_Stop")
    end
end

local function executeEmote(emoteName, character)
    stopAllEmotes() -- Clear previous state

    if emoteName == "Emote_6(SillyBilly)" then
        currentProp = SpawnSillyBillyMic(character or LocalPlayer.Character)
        SendSignal("SillyBilly_Start")
    end
end

local function openInfoMenu(emoteName, charClone)
    if emoteName == "Emote_6(SillyBilly)" then
        SpawnSillyBillyMic(charClone)
    end
end
