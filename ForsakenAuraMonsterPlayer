local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
local RootPart = Character:WaitForChild("HumanoidRootPart")

local RemoteEvent = ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Network"):WaitForChild("Network"):WaitForChild("RemoteEvent")
local EmotesFolder = ReplicatedStorage:WaitForChild("Assets"):WaitForChild("Emotes")

-- Emote Database Configuration
local EmoteDatabase = {
    ["#AuraMonster"] = {
        AnimationId = "rbxassetid://134305747955119",
        SoundId = "rbxassetid://116137438955705",
        HasHandles = true
    },
    ["OppaGangnam"] = {
        AnimationId = "rbxassetid://108308837970067",
        SoundId = "rbxassetid://121721906007526",
        HasHandles = false
    }
}

local SOUND_NAME = "ClientEmoteSFX"

-- Track active instances globally to prevent overlapping
local ActiveTrack = nil
local ActiveAuraClone = nil
local ActiveSound = nil
local StateConnection = nil

-- Forward declaration of stop function
local stopCurrentEmote

stopCurrentEmote = function()
    print("[Client Emote] Cleaning up active emote assets.")

    if StateConnection then
        StateConnection:Disconnect()
        StateConnection = nil
    end

    if ActiveTrack then
        ActiveTrack:Stop()
        ActiveTrack = nil
    end

    if ActiveAuraClone then
        ActiveAuraClone:Destroy()
        ActiveAuraClone = nil
    end

    if ActiveSound then
        ActiveSound:Stop()
        ActiveSound:Destroy()
        ActiveSound = nil
    end

    -- Thorough cleanup verification
    local lingeringSound = RootPart and RootPart:FindFirstChild(SOUND_NAME)
    if lingeringSound then
        lingeringSound:Destroy()
    end
end

-- Function to execute specific emote data safely
local function startEmoteEffects(emoteName, config)
    if not RootPart or not Humanoid then return end
    
    -- Anti-Overlap Safety: Kill any currently playing custom emote before starting a new one
    if RootPart:FindFirstChild(SOUND_NAME) or ActiveTrack or ActiveAuraClone then
        print("[Client Emote] An emote is already running. Cleaning up old track first...")
        stopCurrentEmote()
    end

    print("[Client Emote] Starting execution for: " .. emoteName)

    -- 1. Create and Play Sound
    ActiveSound = Instance.new("Sound")
    ActiveSound.Name = SOUND_NAME
    ActiveSound.SoundId = config.SoundId
    ActiveSound.Volume = 1
    ActiveSound.Looped = true
    ActiveSound.Parent = RootPart
    ActiveSound:Play()

    -- 2. Play Animation Track
    local anim = Instance.new("Animation")
    anim.AnimationId = config.AnimationId
    ActiveTrack = Humanoid:LoadAnimation(anim)
    ActiveTrack:Play()

    -- 3. Handles Processing (Only for Emotes that use them like #AuraMonster)
    if config.HasHandles then
        local auraAsset = EmotesFolder:FindFirstChild(emoteName) and EmotesFolder[emoteName]:FindFirstChild("AuraMonster")
        if auraAsset then
            ActiveAuraClone = auraAsset:Clone()
            ActiveAuraClone.Parent = Character

            if ActiveAuraClone:FindFirstChild("BIGAURA") and ActiveAuraClone.BIGAURA:FindFirstChild("VFXPartMotor") then
                ActiveAuraClone.BIGAURA.VFXPartMotor.Part0 = RootPart
            end
            if ActiveAuraClone:FindFirstChild("StepPart1") and ActiveAuraClone.StepPart1:FindFirstChild("Step1Motor") then
                ActiveAuraClone.StepPart1.Step1Motor.Part0 = RootPart
            end
            if ActiveAuraClone:FindFirstChild("StepPart2") and ActiveAuraClone.StepPart2:FindFirstChild("Step2Motor") then
                ActiveAuraClone.StepPart2.Step2Motor.Part0 = RootPart
            end

            if ActiveAuraClone:FindFirstChild("BIGAURA") then
                for _, v in ipairs(ActiveAuraClone.BIGAURA:GetChildren()) do
                    if v:IsA("ParticleEmitter") then
                        v.Enabled = true
                    end
                end
            end
        end
    end

    -- 4. Listen for Jump state to instantly stop the emote
    StateConnection = Humanoid.StateChanged:Connect(function(_, newState)
        if newState == Enum.HumanoidStateType.Jumping or newState == Enum.HumanoidStateType.Freefall then
            print("[Client Emote] Jump/Fall detected! Halting script tracks.")
            
            -- Tell the server we stopped playing the emote
            local stopArgs = {
                "StopEmote",
                {
                    buffer.fromstring("\003\t\000\000\000Animations"),
                    buffer.fromstring("\003\004\000\000\000Wave")
                }
            }
            RemoteEvent:FireServer(unpack(stopArgs))
            
            stopCurrentEmote()
        end
    end)
end

-- Update character references when resetting/respawning
local function setupCharacter(newChar)
    Character = newChar
    Humanoid = newChar:WaitForChild("Humanoid")
    RootPart = newChar:WaitForChild("HumanoidRootPart")
    stopCurrentEmote()
end
LocalPlayer.CharacterAdded:Connect(setupCharacter)

-- Helper function to decode strings packed in the game's buffer format
local function decodeStringFromBuffer(b)
    if typeof(b) ~= "buffer" then return "" end
    local rawString = buffer.tostring(b)
    local header = string.byte(rawString, 1)
    
    if header == 3 then
        local success, len = pcall(string.unpack, "<I4", rawString, 2)
        if success and len then
            return string.sub(rawString, 6, 5 + len)
        end
    end
    return ""
end

-- Hook the RemoteEvent to handle incoming server commands
local Hook
Hook = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    if self == RemoteEvent and method == "FireServer" then
        local remoteAction = args[1]
        
        if remoteAction == "PlayEmote" and type(args[2]) == "table" then
            local emoteName = decodeStringFromBuffer(args[2][2])
            local targetConfig = EmoteDatabase[emoteName]
            
            -- If the payload matches any configurations inside our database dictionary
            if targetConfig then
                task.spawn(startEmoteEffects, emoteName, targetConfig)
            end
            
        elseif remoteAction == "StopEmote" then
            -- Intercepts any manual stop call to cleanly wipe out running audio/visual instances
            task.spawn(stopCurrentEmote)
        end
    end
    
    return Hook(self, ...)
end)

print("[System Matrix Online] Multi-Emote tracker activated cleanly without duplication overlaps!")
