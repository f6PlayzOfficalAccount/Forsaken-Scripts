-- CAMERA
local function enableCamLock(character)
    local head = character:FindFirstChild("Head")
    if head then
        camera.CameraSubject = head
        camera.CameraType = Enum.CameraType.Custom
    end
end

local function disableCamLock(character)
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        camera.CameraSubject = humanoid
        camera.CameraType = Enum.CameraType.Custom
    end
end

-- HELPER TO CLEAN PROPS SAFELY
local function clearCurrentProps()
    if type(currentProp) == "table" then
        for _, prop in ipairs(currentProp) do
            if typeof(prop) == "Instance" then
                prop:Destroy()
            end
        end
    elseif typeof(currentProp) == "Instance" then
        currentProp:Destroy()
    end
    currentProp = {}
end

-- STOP ALL
local function stopAll()
    actionId += 1
    
    clearCurrentProps()

    local character = player.Character
    if character then
        local oldMewProp = character:FindFirstChild("MEW_HANDLE")
        if oldMewProp then
            oldMewProp:Destroy()
        end
    end

    if currentAnim then
        currentAnim:Stop()
        currentAnim = nil
    end

    if currentSound then
        currentSound:Stop()
        currentSound:Destroy()
        currentSound = nil
    end

    if loopConnection then
        loopConnection:Disconnect()
        loopConnection = nil
    end

    if autoWalkConnection then
        autoWalkConnection:Disconnect()
        autoWalkConnection = nil
    end

    if speedTrackConnection then
        speedTrackConnection:Disconnect()
        speedTrackConnection = nil
    end

    if syncConnection then
        syncConnection:Disconnect()
        syncConnection = nil
    end

    if character then
        disableCamLock(character)
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.WalkSpeed = 16
        end
    end
end

-- ANIMATION SYNC FUNCTION (100 STUDS DISTANCE)
-- ANIMATION & AUDIO SYNC FUNCTION (100 STUDS DISTANCE)
-- ANIMATION & AUDIO SYNC FUNCTION (100 STUDS DISTANCE)
local function startAnimationSync(localTrack, targetAnimId)
    if syncConnection then syncConnection:Disconnect() end

    syncConnection = RunService.RenderStepped:Connect(function()
        if not localTrack or not localTrack.IsPlaying then
            if syncConnection then
                syncConnection:Disconnect()
                syncConnection = nil
            end
            return
        end

        local myChar = player.Character
        local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myHrp then return end

        -- SMOOTH AUDIO SYNC (NO POPS)
        if currentSound and currentSound.IsPlaying and currentSound.TimeLength > 0 and localTrack.Length > 0 then
            local targetTime = localTrack.TimePosition % currentSound.TimeLength
            local diff = targetTime - currentSound.TimePosition

            -- Handle loop wrap-around
            if diff < -currentSound.TimeLength / 2 then
                diff = diff + currentSound.TimeLength
            elseif diff > currentSound.TimeLength / 2 then
                diff = diff - currentSound.TimeLength
            end

            -- If drift is huge, hard-seek (rare). Otherwise, smoothly alter playback speed
            if math.abs(diff) > 0.25 then
                currentSound.TimePosition = targetTime
                currentSound.PlaybackSpeed = 1
            elseif math.abs(diff) > 0.03 then
                currentSound.PlaybackSpeed = math.clamp(1 + (diff * 0.5), 0.95, 1.05)
            else
                currentSound.PlaybackSpeed = 1
            end
        end

        -- ANIMATION SYNC (100 STUDS)
        for _, otherPlayer in ipairs(Players:GetPlayers()) do
            if otherPlayer ~= player and otherPlayer.Character then
                local otherHrp = otherPlayer.Character:FindFirstChild("HumanoidRootPart")
                local otherHum = otherPlayer.Character:FindFirstChildOfClass("Humanoid")

                if otherHrp and otherHum then
                    local distance = (myHrp.Position - otherHrp.Position).Magnitude
                    if distance <= 100 then
                        local animator = otherHum:FindFirstChildOfClass("Animator")
                        if animator then
                            for _, playingTrack in ipairs(animator:GetPlayingAnimationTracks()) do
                                if playingTrack.Animation and playingTrack.Animation.AnimationId == targetAnimId then
                                    if math.abs(localTrack.TimePosition - playingTrack.TimePosition) > 0.08 then
                                        localTrack.TimePosition = playingTrack.TimePosition
                                    end
                                    return
                                end
                            end
                        end
                    end
                end
            end
        end
    end)
end

-- SPEED TRACKER
local function trackAnimationSpeed(track, humanoid, targetSpeed)
    if speedTrackConnection then speedTrackConnection:Disconnect() end
    speedTrackConnection = RunService.RenderStepped:Connect(function()
        if track and track.IsPlaying and humanoid then
            humanoid.WalkSpeed = targetSpeed
        else
            if speedTrackConnection then
                speedTrackConnection:Disconnect()
                speedTrackConnection = nil
            end
            if humanoid then humanoid.WalkSpeed = 16 end
        end
    end)
end

-- START LOOP (MULTI-STAGE INTRO -> LOOP EMOTE HANDLER)
local function StartLoop(introAnimId, introSoundId, transitionDelay, loopAnimId, loopSoundId, isSpeedEmote, speedVal)
    stopAll()
    local myActionId = actionId
    local character = getCharacter()
    enableCamLock(character)
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)

    -- Play Intro Animation
    local introAnim = Instance.new("Animation")
    introAnim.AnimationId = introAnimId
    local introTrack = animator:LoadAnimation(introAnim)
    introTrack.Priority = Enum.AnimationPriority.Action4
    introTrack.Looped = false
    introTrack:Play()
    currentAnim = introTrack
    startAnimationSync(introTrack, introAnimId)

    -- Play Intro Sound
    if introSoundId then
        local sound = Instance.new("Sound")
        sound.SoundId = introSoundId
        sound.Parent = character:WaitForChild("HumanoidRootPart")
        sound:Play()
        currentSound = sound
    end

    if isSpeedEmote and speedVal then
        trackAnimationSpeed(introTrack, humanoid, speedVal)
    end

    -- Transition to Loop Stage
    task.delay(transitionDelay, function()
        if actionId ~= myActionId then return end

        if currentAnim then currentAnim:Stop() end
        if currentSound then currentSound:Stop() currentSound:Destroy() end

        local loopAnim = Instance.new("Animation")
        loopAnim.AnimationId = loopAnimId
        local loopTrack = animator:LoadAnimation(loopAnim)
        loopTrack.Priority = Enum.AnimationPriority.Action4
        loopTrack.Looped = true
        loopTrack:Play()
        currentAnim = loopTrack
        startAnimationSync(loopTrack, loopAnimId)

        if loopSoundId then
            local sound = Instance.new("Sound")
            sound.SoundId = loopSoundId
            sound.Looped = true
            sound.Parent = character:WaitForChild("HumanoidRootPart")
            sound:Play()
            currentSound = sound
        end

        if isSpeedEmote and speedVal then
            trackAnimationSpeed(loopTrack, humanoid, speedVal)
        end
    end)
end

