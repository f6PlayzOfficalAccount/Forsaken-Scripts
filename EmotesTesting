local function SpawnMewEmote(character)
    local emoteTemplate = game:GetService("ReplicatedStorage")
        :FindFirstChild("Assets")
        and game:GetService("ReplicatedStorage").Assets:FindFirstChild("Emotes")
        and game:GetService("ReplicatedStorage").Assets.Emotes:FindFirstChild("#MewMew")
        and game:GetService("ReplicatedStorage").Assets.Emotes["#MewMew"]:FindFirstChild("MEWEMOTE")

    if not emoteTemplate then return end

    local rightArm = character:FindFirstChild("Right Arm") or character:FindFirstChild("RightHand")
    local leftArm = character:FindFirstChild("Left Arm") or character:FindFirstChild("LeftHand")
    local primaryPart = character.PrimaryPart or character:FindFirstChild("HumanoidRootPart")

    if not (rightArm and leftArm and primaryPart) then return end

    local clonedEmote = emoteTemplate:Clone()
    clonedEmote.Name = "MEW_HANDLE"
    clonedEmote.Parent = character

    if clonedEmote:FindFirstChild("RightLight") and clonedEmote.RightLight:FindFirstChild("RIGHTWELD") then
        clonedEmote.RightLight.RIGHTWELD.Part0 = rightArm
    end
    if clonedEmote:FindFirstChild("LeftLight") and clonedEmote.LeftLight:FindFirstChild("LEFTWELD") then
        clonedEmote.LeftLight.LEFTWELD.Part0 = leftArm
    end
    if clonedEmote:FindFirstChild("NOTHINGWELD") then
        clonedEmote.NOTHINGWELD.Part0 = primaryPart
    end

    return clonedEmote
end

