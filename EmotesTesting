local function LoadSukunaAssets(character)
	local assets = {
		game:GetService("ReplicatedStorage").Assets.Emotes.Sukuna.DismantleFX,
		game:GetService("ReplicatedStorage").Assets.Emotes.Sukuna.LeftHandle,
		game:GetService("ReplicatedStorage").Assets.Emotes.Sukuna.RightHandle,
	}

	local spawnedAssets = {}

	for _, raw in assets do
		if raw then
			local clone = raw:Clone()
			clone.Parent = character

			if raw.Name == "LeftHandle" or raw.Name == "RightHandle" then
				local side = (raw.Name == "LeftHandle") and "Left" or "Right"
				local arm = character:FindFirstChild(side .. " Arm") or character:FindFirstChild(side .. "Hand")

				if arm then
					for _, child in clone:GetDescendants() do
						if child:IsA("BasePart") then
							child.Color = arm.Color
						end
					end

					local motor = clone:FindFirstChildWhichIsA("Motor6D", true)
					if motor then
						motor.Part0 = arm
					end
				end
			end

			table.insert(spawnedAssets, clone)
		end
	end

	return spawnedAssets
end

local function SpawnShucksAssets(character)
    local spawnedAssets = {}

    local rightArm = character:FindFirstChild("Right Arm") or character:FindFirstChild("RightHand")
    local leftArm = character:FindFirstChild("Left Arm") or character:FindFirstChild("LeftHand")

    -- 1. BUILD SAW MODEL (Right Arm)
    if rightArm then
        local sawModel = Instance.new("Model")
        sawModel.Name = "Saw"

        -- Primary Root Part
        local root = Instance.new("Part")
        root.Name = "Root"
        root.Size = Vector3.new(1.000, 2.000, 1.000)
        root.Color = Color3.fromRGB(205, 205, 205)
        root.Transparency = 1.00
        root.CanCollide = false
        root.Anchored = false
        root.Parent = sawModel

        -- Saw-Model Hand (Mounted on arm)
        local hand = Instance.new("Part")
        hand.Name = "Hand"
        hand.Size = Vector3.new(1.062, 0.637, 1.062)
        hand.Color = Color3.fromRGB(163, 162, 165)
        hand.CanCollide = false
        hand.Anchored = false
        hand.Parent = sawModel

        -- Connecting Bar (Links Hand to BuzzSaw)
        local bar = Instance.new("Part")
        bar.Name = "Bar"
        bar.Shape = Enum.PartType.Cylinder
        bar.Size = Vector3.new(0.833, 0.088, 0.143) -- Adjusted orientation for cylinder length
        bar.Color = Color3.fromRGB(163, 162, 165)
        bar.CanCollide = false
        bar.Anchored = false
        bar.Parent = sawModel

        -- Spinning Blade
        local buzzSaw = Instance.new("Part")
        buzzSaw.Name = "BuzzSaw"
        buzzSaw.Size = Vector3.new(1.038, 1.038, 0.519)
        buzzSaw.Color = Color3.fromRGB(205, 205, 205)
        buzzSaw.CanCollide = false
        buzzSaw.Anchored = false
        buzzSaw.Parent = sawModel

        -- Blade Mesh
        local mesh = Instance.new("SpecialMesh")
        mesh.Name = "Mesh"
        mesh.MeshType = Enum.MeshType.FileMesh
        mesh.MeshId = "rbxassetid://74322089"
        mesh.TextureId = "rbxassetid://74322092"
        mesh.Scale = Vector3.new(1.038, 1.038, 0.519)
        mesh.Offset = Vector3.new(0, 0, 0)
        mesh.Parent = buzzSaw

        -- Alignments Relative to Right Arm
        root.CFrame = rightArm.CFrame
        hand.CFrame = root.CFrame * CFrame.new(0, -0.719, 0)
        
        -- Position Bar bridging Hand (-0.719) down to BuzzSaw (-1.786)
        bar.CFrame = root.CFrame * CFrame.new(0.031, -1.252, 0) * CFrame.Angles(0, 0, math.rad(90))
        buzzSaw.CFrame = root.CFrame * CFrame.new(0.031, -1.786, 0)

        -- Static Structural Welds
        local rootWeld = Instance.new("WeldConstraint")
        rootWeld.Name = "WeldConstraint"
        rootWeld.Part0 = rightArm
        rootWeld.Part1 = root
        rootWeld.Parent = root

        local handWeld = Instance.new("WeldConstraint")
        handWeld.Name = "WeldConstraint"
        handWeld.Part0 = root
        handWeld.Part1 = hand
        handWeld.Parent = hand

        -- Weld Bar to Hand so it stays fixed as the connecting rod
        local barWeld = Instance.new("WeldConstraint")
        barWeld.Name = "WeldConstraint"
        barWeld.Part0 = hand
        barWeld.Part1 = bar
        barWeld.Parent = bar

        -- Motor6D Setup for BuzzSaw Spin
        local sawMotor = Instance.new("Motor6D")
        sawMotor.Name = "BuzzSaw"
        sawMotor.Part0 = rightArm
        sawMotor.Part1 = buzzSaw
        sawMotor.C0 = CFrame.new(0.031, -1.786, 0, 0, 0, -1, 0, 1, 0, 1, 0, 0)
        sawMotor.C1 = CFrame.new(0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1)
        sawMotor.Parent = sawModel

        -- Spin Connection
        local spinConn
        spinConn = RunService.RenderStepped:Connect(function(dt)
            if sawModel and sawModel.Parent then
                sawMotor.C0 = sawMotor.C0 * CFrame.Angles(0, 0, math.rad(1400 * dt))
            else
                spinConn:Disconnect()
            end
        end)

        sawModel.Parent = character
        table.insert(spawnedAssets, sawModel)
    end

    -- 2. SPAWN SUKUNA LEFT HANDLE (Left Arm)
    local rawLeftHandle = game:GetService("ReplicatedStorage"):FindFirstChild("Assets") 
        and game:GetService("ReplicatedStorage").Assets:FindFirstChild("Emotes")
        and game:GetService("ReplicatedStorage").Assets.Emotes:FindFirstChild("Sukuna")
        and game:GetService("ReplicatedStorage").Assets.Emotes.Sukuna:FindFirstChild("LeftHandle")

    if rawLeftHandle and leftArm then
        local handleClone = rawLeftHandle:Clone()
        handleClone.Name = "PlayerEmoteHand"
        
        for _, v in ipairs(handleClone:GetDescendants()) do
            if v:IsA("BasePart") then
                v.Color = leftArm.Color
            end
        end

        local motor = handleClone:FindFirstChildWhichIsA("Motor6D", true)
        if motor then
            motor.Part0 = leftArm
        end

        handleClone.Parent = character
        table.insert(spawnedAssets, handleClone)
    end

    return spawnedAssets
end

