    if viewportRenderConn then viewportRenderConn:Disconnect() end
    if viewportSound then viewportSound:Destroy() viewportSound = nil end
    
    if type(viewportProp) == "table" then
        for _, p in ipairs(viewportProp) do if typeof(p) == "Instance" then p:Destroy() end end
    elseif typeof(viewportProp) == "Instance" then 
        viewportProp:Destroy() 
    end
    viewportProp = nil
    
    if viewportWorldModel then viewportWorldModel:Destroy() viewportWorldModel = nil end
end

closeBtn.MouseButton1Click:Connect(closeInfoMenu)

local function openInfoMenu(name, imageId, animId, soundId, SongLoop, loopanim, customIcon, customDesc)
    closeInfoMenu()
    
    infoImage.Image = customIcon or imageId or "rbxassetid://0"
    nameLabel.Text = name
    descLabel.Text = customDesc or "No description provided for " .. name .. "."

    viewportWorldModel = Instance.new("WorldModel")
    viewportWorldModel.Parent = viewportFrame

    local char = getCharacter()
    char.Archivable = true
    local charClone = char:Clone()
    char.Archivable = false

    for _, obj in ipairs(charClone:GetDescendants()) do
        if obj:IsA("Motor6D") then
            if obj.Name == "Neck" then
                obj.C0 = CFrame.new(0, 1, 0, -1, 0, 0, 0, 0, 1, 0, 1, -0)
                obj.C1 = CFrame.new(0, -0.5, 0, -1, 0, 0, 0, 0, 1, 0, 1, -0)
            elseif obj.Name == "Waist" or obj.Name == "RootJoint" then
                obj.Transform = CFrame.identity
            end
        elseif obj:IsA("BasePart") then
            obj.Velocity = Vector3.zero
            obj.RotVelocity = Vector3.zero
        end
    end

    charClone:SetPrimaryPartCFrame(CFrame.new(0, 0, 0))
    charClone.Parent = viewportWorldModel

    if name == "Stop" then viewportProp = SpawnStopSign(charClone) end
    if name == "seal (Pets)" then viewportProp = SpawnSeal(charClone) end
    if name == "Guitar (JSAB John Doe)" then viewportProp = SpawnGuitar_2(charClone) end
    if name == "Slayerrr" then viewportProp = SpawnGuitar_1(charClone) end
    if name == "#MonsterAura" then viewportProp = SpawnAuraMonster(charClone) end
    if name == "Mewers Live" then viewportProp = SpawnMewEmote(charClone) end
    if name == "Mewers Live2" then viewportProp = SpawnMewEmote2(charClone) end
    if name == "Old The Phone" then viewportProp = ThePhoneHandle(charClone) end
    if name == "No" then viewportProp = RightHand(charClone) end
    if name == "Emote_4(TickTock) A2" or name == "Emote_4(TickTock)" or name == "Emote_7(shucks)" or name == "Emote_3(Suter Fudge)" or name == "Emote_5(MissTheQuiet)" or name == "Ko-ma Dio da" then 
        viewportProp = LoadSukunaAssets(charClone) 
    end

    local hrp = charClone:FindFirstChild("HumanoidRootPart") or charClone.PrimaryPart
    if hrp then
        viewportCam = Instance.new("Camera")
        viewportCam.CFrame = CFrame.new(Vector3.new(0, 0, -5.5), Vector3.new(0, 0, 0))
        viewportFrame.CurrentCamera = viewportCam
        viewportCam.Parent = viewportFrame

        local rotAngle = 0
        viewportRenderConn = RunService.RenderStepped:Connect(function(dt)
            rotAngle += dt * 0.6
            local camPos = Vector3.new(math.sin(rotAngle) * 5.5, 0.5, math.cos(rotAngle) * 5.5)
            viewportCam.CFrame = CFrame.new(camPos, Vector3.new(0, 0, 0))
        end)
    end

    local hum = charClone:FindFirstChildOfClass("Humanoid")
    if hum then
        local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
        
        local chosenAnim = animId
        if CustomRandomAnimations[name] then
            local list = CustomRandomAnimations[name]
            chosenAnim = list[math.random(#list)]
        end

        if chosenAnim then
            task.defer(function()
                local animObj = Instance.new("Animation")
                animObj.AnimationId = chosenAnim
                viewportAnimTrack = animator:LoadAnimation(animObj)
                viewportAnimTrack.Priority = Enum.AnimationPriority.Action4
                viewportAnimTrack.Looped = (loopanim == true or loopanim == nil)
                viewportAnimTrack:Play()
            end)
        end
    end

    local chosenSound = soundId
    if CustomRandomMusic[name] then
        local list = CustomRandomMusic[name]
        chosenSound = list[math.random(#list)]
    end

    if name == "Emote_6(SillyBilly)" then
        local Sounds = {"rbxassetid://77601084987544", "rbxassetid://120176009143091"}
        chosenSound = Sounds[math.random(#Sounds)]
    end
    if name == "No" then
        local Sounds = {"rbxassetid://2781528288", "rbxassetid://2571949879", "rbxassetid://739162051", "rbxassetid://1272001139", "rbxassetid://6975494962", "rbxassetid://5627724798"}
        chosenSound = Sounds[math.random(#Sounds)]
    end
    if name == "Emote_1(Gangnam)" then
        local Sounds = {"rbxassetid://121721906007526", "rbxassetid://100866147198228","rbxassetid://73136812934449"}
        chosenSound = Sounds[math.random(#Sounds)]
    end

    if chosenSound then
        viewportSound = Instance.new("Sound")
        viewportSound.SoundId = chosenSound
        viewportSound.Looped = not SongLoop
        viewportSound.Parent = infoFrame
        viewportSound:Play()
    end

    infoFrame.Visible = true
end

